<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A platform theme, not an AppCompat one: the UI is Compose, so the XML
      theme's only job is to hand over a black window with no action bar and get
      out of the way. Anything else here would be a second place where colour
      decisions live.
    -->
    <style name="Theme.A3004" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0C10</item>
        <item name="android:statusBarColor">#0A0C10</item>
        <item name="android:navigationBarColor">#0A0C10</item>
    </style>
</resources>
