<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Joining the router's own AP: the router is the network, so a tablet that
         walks around with the vehicle has to be associated to it. ACCESS/CHANGE
         WIFI_STATE are only needed for the API 29 suggestion path; the API 30+
         route goes through a system dialog and needs neither. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- requestNetwork() needs this. Without it the call throws and the app
         quietly falls back to asking the user to join the AP by hand, which is
         the behaviour this whole path exists to avoid. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:label="A3004 Bridge"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.A3004"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- The router serves plain HTTP on a LAN with no DNS, so cleartext to
             any host is required; there is nothing to encrypt against here and
             a self-signed cert would only add a warning to dismiss. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
